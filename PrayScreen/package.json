{
  "name": "prayscreen",
  "version": "1.0.0",
  "description": "Prayer-based app blocker for spiritual discipline",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "pods": "cd ios && pod install && cd ..",
    "postinstall": "test \"$(uname)\" = 'Darwin' && cd ios && pod install && cd .. || exit 0"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.76.3",
    "@react-navigation/native": "^7.0.13",
    "@react-navigation/native-stack": "^7.1.9",
    "@react-navigation/bottom-tabs": "^7.1.9",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-screens": "^4.4.0",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "react-native-mmkv": "^3.1.0",
    "zustand": "^5.0.3",
    "react-native-purchases": "^8.3.1",
    "react-native-google-mobile-ads": "^15.4.0",
    "@notifee/react-native": "^9.1.8",
    "react-native-svg": "^15.9.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^3.16.6",
    "react-native-gesture-handler": "^2.21.2",
    "date-fns": "^4.1.0",
    "axios": "^1.13.2",
    "react-native-device-info": "^14.0.2",
    "react-native-permissions": "^5.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "^0.76.3",
    "@react-native/eslint-config": "^0.76.3",
    "@react-native/metro-config": "^0.76.3",
    "@react-native/typescript-config": "^0.76.3",
    "@types/react": "^18.3.3",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.19.0",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
